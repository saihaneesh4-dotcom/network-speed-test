import socket
import json

DISCOVERY_PORT = 6100
IPERF3_PORT = 5201

# Shared measurement configuration
MEASURED_DURATION_SEC = 5
RAMP_UP_SEC = 2
PARALLEL_STREAMS = 4


def main():
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind(("0.0.0.0", DISCOVERY_PORT))

        print(
            f"iperf3 discovery responder listening on "
            f"UDP {DISCOVERY_PORT}"
        )

        while True:
            try:
                data, client_address = sock.recvfrom(2048)

                if data.strip() != b"DISCOVER_IPERF3":
                    continue

                response = {
                    "service": "iperf3",
                    "port": IPERF3_PORT,
                    "duration_sec": MEASURED_DURATION_SEC,
                    "ramp_up_sec": RAMP_UP_SEC,
                    "streams": PARALLEL_STREAMS
                }

                sock.sendto(
                    json.dumps(response).encode("utf-8"),
                    client_address
                )

                print(
                    f"Responded to {client_address[0]}:"
                    f"{client_address[1]}"
                )

            except OSError as error:
                print("Socket error:", error)


if __name__ == "__main__":
    main()